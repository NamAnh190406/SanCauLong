<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.mavenproject1.SanCauLongController">
   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>
   <children>
      <!-- ===== ROOT: Schedule (left) + Detail panel (right) ===== -->
      <HBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

         <!-- ===== LEFT: full schedule area ===== -->
         <VBox style="-fx-background-color: white;" HBox.hgrow="ALWAYS">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: white; -fx-padding: 12 20;                          -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
               <FontAwesomeIconView glyphName="CHEVRON_LEFT" onMouseClicked="#onBackClick" size="15" />

               <Button fx:id="btnPrevDay" mnemonicParsing="false" onAction="#onPrevDay" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151;                               -fx-font-size: 14; -fx-cursor: hand;                               -fx-background-radius: 6; -fx-min-width: 34; -fx-min-height: 34;" text="❮">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor></Button>

               <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #f9fafb; -fx-background-radius: 8;                             -fx-padding: 6 16; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                  <Label style="-fx-font-size: 14; -fx-text-fill: #6b7280;" text="📅" />
                  <Label fx:id="lblDate" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #111827;" text="01/05/2026" />
               </HBox>

               <Button fx:id="btnNextDay" mnemonicParsing="false" onAction="#onNextDay" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151;                               -fx-font-size: 14; -fx-cursor: hand;                               -fx-background-radius: 6; -fx-min-width: 34; -fx-min-height: 34;" text="❯" />

               <Region HBox.hgrow="ALWAYS" />

               <Button fx:id="btnAddBooking" mnemonicParsing="false" onAction="#onAddBooking" style="-fx-background-color: #f59e0b; -fx-text-fill: white;                               -fx-font-weight: bold; -fx-font-size: 13;                               -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 18;" text="+ Thêm đặt sân">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor></Button>
            </HBox>

            <!-- SCHEDULE GRID -->
            <ScrollPane fx:id="scheduleScroll" fitToWidth="true" hbarPolicy="AS_NEEDED" style="-fx-background-color: white; -fx-background: white;                                -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <content>
                  <GridPane fx:id="scheduleGrid" gridLinesVisible="true" style="-fx-background-color: white;" />
               </content>
            </ScrollPane>

            <!-- LEGEND -->
            <HBox alignment="CENTER_LEFT" spacing="24" style="-fx-background-color: white; -fx-padding: 10 20;                          -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
               <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label style="-fx-background-color: white; -fx-border-color: #d1d5db;                                 -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;                                 -fx-min-width: 18; -fx-min-height: 18;                                 -fx-max-width: 18; -fx-max-height: 18;" text="" />
                  <Label style="-fx-font-size: 12; -fx-text-fill: #374151;" text="Trống" />
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label style="-fx-background-color: #fef9c3; -fx-border-color: #fcd34d;                                 -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;                                 -fx-min-width: 18; -fx-min-height: 18;                                 -fx-max-width: 18; -fx-max-height: 18;" text="" />
                  <Label style="-fx-font-size: 12; -fx-text-fill: #374151;" text="Đã đặt" />
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label style="-fx-background-color: #dcfce7; -fx-border-color: #86efac;                                 -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;                                 -fx-min-width: 18; -fx-min-height: 18;                                 -fx-max-width: 18; -fx-max-height: 18;" text="" />
                  <Label style="-fx-font-size: 12; -fx-text-fill: #374151;" text="Đang chơi" />
               </HBox>
            </HBox>

         </VBox>

         <!-- ===== RIGHT: Detail panel (hidden by default) ===== -->
         <VBox fx:id="detailPanel" managed="false" maxWidth="300" minWidth="300" prefWidth="300" style="-fx-background-color: white;                       -fx-border-color: #e5e7eb; -fx-border-width: 0 0 0 1;" visible="false">

            <!-- Panel header -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 14 16; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
               <Label style="-fx-font-size: 15;" text="📋" />
               <Label style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Thông tin đặt sân" />
               <Region HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" onAction="#onCloseDetail" style="-fx-background-color: transparent; -fx-text-fill: #6b7280;                               -fx-font-size: 14; -fx-cursor: hand; -fx-padding: 2 6;" text="✕" />
            </HBox>

            <!-- Scrollable content -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f9fafb; -fx-background: #f9fafb;                                -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox spacing="12" style="-fx-padding: 14;">

                     <!-- Booking info card -->
                     <VBox fx:id="infoCard" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10;                                   -fx-padding: 14; -fx-border-color: #f3f4f6;                                   -fx-border-width: 1; -fx-border-radius: 10;">

                        <!-- Dynamic rows injected by controller -->
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Khách hàng" />
                           <Label fx:id="lblCustomer" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Số điện thoại" />
                           <Label fx:id="lblPhone" style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Sân" />
                           <Label fx:id="lblCourt" style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Thời gian" />
                           <Label fx:id="lblTime" style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Ngày" />
                           <Label fx:id="lblBookingDate" style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Trạng thái" />
                           <Label fx:id="lblStatus" style="-fx-font-size: 11; -fx-font-weight: bold;                                          -fx-background-radius: 5; -fx-padding: 3 10;" text="Đã đặt" />
                        </VBox>
                        <VBox spacing="2">
                           <Label style="-fx-font-size: 11; -fx-text-fill: #6b7280;" text="Tổng tiền" />
                           <Label fx:id="lblTotal" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="-" />
                        </VBox>

                        <Separator />

                        <!-- Action buttons -->
                        <Button fx:id="btnConfirm" maxWidth="Infinity" mnemonicParsing="false" onAction="#onConfirmBooking" style="-fx-background-color: #16a34a; -fx-text-fill: white;                                        -fx-font-weight: bold; -fx-background-radius: 8;                                        -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" text="✔ Xác nhận" />
                        <Button fx:id="btnEdit" maxWidth="Infinity" mnemonicParsing="false" onAction="#onEditBooking" style="-fx-background-color: #f59e0b; -fx-text-fill: white;                                        -fx-font-weight: bold; -fx-background-radius: 8;                                        -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" text="✏ Chỉnh sửa" />
                        <Button fx:id="btnCancelBooking" maxWidth="Infinity" mnemonicParsing="false" onAction="#onCancelBooking" style="-fx-background-color: #ef4444; -fx-text-fill: white;                                        -fx-font-weight: bold; -fx-background-radius: 8;                                        -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" text="🗑 Hủy đặt sân" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCloseDetail" style="-fx-background-color: #6b7280; -fx-text-fill: white;                                        -fx-font-weight: bold; -fx-background-radius: 8;                                        -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" text="✖ Đóng" />
                     </VBox>

                     <!-- Waiting list -->
                     <VBox fx:id="waitingListBox" spacing="8" style="-fx-background-color: white; -fx-background-radius: 10;                                   -fx-padding: 14; -fx-border-color: #f3f4f6;                                   -fx-border-width: 1; -fx-border-radius: 10;">
                        <Label style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;" text="⏳ Danh sách đợi" />
                        <!-- Items injected by controller -->
                     </VBox>

                  </VBox>
               </content>
            </ScrollPane>
         </VBox>

      </HBox>
   </children>
</AnchorPane>
