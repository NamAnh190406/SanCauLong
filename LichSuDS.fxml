<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="800" prefWidth="1200" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.mavenproject1.LichSuDSController">
    
    <!-- MÀN HÌNH CHÍNH -->
    <VBox prefHeight="800" prefWidth="1200" style="-fx-background-color: #f1f5f9;">

        <!-- ===== HEADER (DARK SLATE) ===== -->
        <VBox spacing="8" style="-fx-background-color: #0f172a; -fx-padding: 24 32 24 32;">
         <FontAwesomeIconView fill="#f8f8f8" glyphName="CHEVRON_LEFT" onMouseClicked="#handleVeTrangChu" size="15">
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
         </FontAwesomeIconView>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Lịch sử đặt sân" />
            </HBox>
            <Label style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-padding: 0 0 0 30;" text="Quản lý, theo dõi trạng thái sân và gửi nhận xét đánh giá của bạn" />
        </VBox>

        <!-- ===== THỐNG KÊ DASHBOARD ===== -->
        <HBox spacing="16" style="-fx-padding: 24 32 0 32;">
            <!-- Tổng đặt sân -->
            <VBox alignment="CENTER" spacing="6" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <Label fx:id="lblTongDS" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="5" />
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #64748b;" text="TỔNG ĐẶT SÂN" />
            </VBox>
            <!-- Hoàn thành -->
            <VBox alignment="CENTER" spacing="6" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <Label fx:id="lblHoanThanh" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="2" />
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="HOÀN THÀNH" />
            </VBox>
            <!-- Đã duyệt -->
            <VBox alignment="CENTER" spacing="6" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <Label fx:id="lblDaDuyet" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="1" />
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="DÃ DUYỆT" />
            </VBox>
            <!-- Chờ duyệt -->
            <VBox alignment="CENTER" spacing="6" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <Label fx:id="lblChoDuyet" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ea580c;" text="1" />
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #ea580c;" text="CHỜ DUYỆT" />
            </VBox>
            <!-- Đã hủy -->
            <VBox alignment="CENTER" spacing="6" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <Label fx:id="lblDaHuy" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="1" />
                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="DÃ HỦY" />
            </VBox>
        </HBox>

        <!-- ===== TABS BỘ LỌC TRẠNG THÁI ===== -->
        <HBox fx:id="tabBar" spacing="0" style="-fx-padding: 24 32 0 32; -fx-background-color: transparent;">
            <Button fx:id="tabTatCa" onAction="#handleTabTatCa" style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8 0 0 8; -fx-padding: 10 24 10 24; -fx-cursor: hand;" text="Tất cả" />
            <Button fx:id="tabChoDuyet" onAction="#handleTabChoDuyet" style="-fx-background-color: #f1f5f9; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-background-radius: 0; -fx-padding: 10 24 10 24; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1 1 1 0;" text="Chờ duyệt" />
            <Button fx:id="tabDaDuyet" onAction="#handleTabDaDuyet" style="-fx-background-color: #f1f5f9; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-background-radius: 0; -fx-padding: 10 24 10 24; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1 1 1 0;" text="Đã duyệt" />
            <Button fx:id="tabHoanThanh" onAction="#handleTabHoanThanh" style="-fx-background-color: #f1f5f9; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-background-radius: 0; -fx-padding: 10 24 10 24; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1 1 1 0;" text="Hoàn thành" />
            <Button fx:id="tabDaHuy" onAction="#handleTabDaHuy" style="-fx-background-color: #f1f5f9; -fx-text-fill: #374151; -fx-font-size: 13px; -fx-background-radius: 0 8 8 0; -fx-padding: 10 24 10 24; -fx-cursor: hand; -fx-border-color: #e2e8f0; -fx-border-width: 1 1 1 0;" text="Đã hủy" />
        </HBox>

        <!-- ===== DANH SÁCH LỊCH SỬ ĐẶT SÂN ===== -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-padding: 16 32 24 32;" VBox.vgrow="ALWAYS">
            <!-- VBox listContainer chứa các ô card đặt sân. 
                 Tôi đã thêm 2 card mẫu ngay trong FXML để khi bạn mở bằng Scene Builder sẽ thấy luôn giao diện thiết kế cực đẹp.
                 Khi chạy phần mềm, các card mẫu này sẽ tự động được xóa đi bằng lệnh listContainer.getChildren().clear() và thay bằng dữ liệu thật. -->
            <VBox fx:id="listContainer" spacing="12" style="-fx-padding: 4 0 4 0; -fx-background-color: transparent;">
                
                <!-- [Card mẫu 1: Chờ duyệt] -->
                <HBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 1);">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Sân Cầu Lông A - Sân 1 (Bản xem trước Scene Builder)" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Mã đặt: DS001  |  Ngày đặt: 2026-05-22" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="🕒 Khung giờ: 17:00 - 19:00  |  Loại: Sân trong nhà (Thảm PVC)" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Tổng tiền: 150,000 VNĐ" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" prefWidth="180" spacing="12">
                        <Label style="-fx-padding: 6 12 6 12; -fx-background-radius: 12; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #fef3c7; -fx-text-fill: #d97706;" text="● Chờ duyệt" />
                        <Button style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14 8 14; -fx-border-color: #fca5a5; -fx-border-radius: 8; -fx-cursor: hand;" text="🗑 Hủy đặt sân" />
                    </VBox>
                </HBox>

                <!-- [Card mẫu 2: Hoàn thành] -->
                <HBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 1);">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Sân Cầu Lông B - Sân 3 (Bản xem trước Scene Builder)" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Mã đặt: DS003  |  Ngày đặt: 2026-05-18" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #4b5563;" text="🕒 Khung giờ: 18:00 - 20:00  |  Loại: Sân ngoài trời (Bê tông sơn)" />
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Tổng tiền: 180,000 VNĐ" />
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" prefWidth="180" spacing="12">
                        <Label style="-fx-padding: 6 12 6 12; -fx-background-radius: 12; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #dcfce7; -fx-text-fill: #16a34a;" text="● Hoàn thành" />
                        <Button style="-fx-background-color: #dcfce7; -fx-text-fill: #15803d; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 14 8 14; -fx-border-color: #86efac; -fx-border-radius: 8; -fx-cursor: hand;" text="⭐ Đánh giá" />
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>

    <!-- ===== POPUP ĐÁNH GIÁ (Màn hình phủ mờ khi mở) ===== -->
    <StackPane fx:id="popupDanhGia" managed="false" prefHeight="800" prefWidth="1200" style="-fx-background-color: rgba(0, 0, 0, 0.6);" visible="false">
        <VBox alignment="CENTER" maxWidth="460" spacing="18" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 30, 0, 0, 10);">
            
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="⭐  Đánh giá sân" />
            <Label fx:id="lblDanhGiaTenSan" style="-fx-font-size: 13px; -fx-text-fill: #64748b; -fx-font-style: italic;" text="Sân A - Mã đặt: DS001" />

            <!-- Chọn số sao (5 nút tương tác vàng) -->
            <VBox alignment="CENTER" spacing="6">
                <HBox alignment="CENTER" spacing="8">
                    <Button fx:id="btnSao1" onAction="#handleSao1" style="-fx-background-color: transparent; -fx-text-fill: #fbbf24; -fx-font-size: 32px; -fx-cursor: hand; -fx-padding: 0 4 0 4;" text="★" />
                    <Button fx:id="btnSao2" onAction="#handleSao2" style="-fx-background-color: transparent; -fx-text-fill: #fbbf24; -fx-font-size: 32px; -fx-cursor: hand; -fx-padding: 0 4 0 4;" text="★" />
                    <Button fx:id="btnSao3" onAction="#handleSao3" style="-fx-background-color: transparent; -fx-text-fill: #fbbf24; -fx-font-size: 32px; -fx-cursor: hand; -fx-padding: 0 4 0 4;" text="★" />
                    <Button fx:id="btnSao4" onAction="#handleSao4" style="-fx-background-color: transparent; -fx-text-fill: #fbbf24; -fx-font-size: 32px; -fx-cursor: hand; -fx-padding: 0 4 0 4;" text="★" />
                    <Button fx:id="btnSao5" onAction="#handleSao5" style="-fx-background-color: transparent; -fx-text-fill: #fbbf24; -fx-font-size: 32px; -fx-cursor: hand; -fx-padding: 0 4 0 4;" text="★" />
                </HBox>
                <Label fx:id="lblMoTaSao" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #d97706;" text="Tuyệt vời! ⭐️⭐️⭐️⭐️⭐️" />
            </VBox>

            <!-- Khung nhập nhận xét -->
            <VBox spacing="6">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #334155;" text="Nhận xét (tuỳ chọn)" />
                <TextArea fx:id="txtNhanXet" prefRowCount="3" promptText="Chia sẻ cảm nhận của bạn về chất lượng sân, dịch vụ, ánh sáng..." style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 8;" wrapText="true" />
            </VBox>

            <Separator style="-fx-padding: 4 0 4 0;" />

            <!-- Nút điều hướng -->
            <HBox spacing="12">
                <Button maxWidth="Infinity" onAction="#handleDongDanhGia" style="-fx-background-color: white; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 0 12 0; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-border-width: 1; -fx-cursor: hand;" text="Hủy" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" onAction="#handleGuiDanhGia" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 0 12 0; -fx-cursor: hand;" text="Gửi đánh giá" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </StackPane>

    <!-- ===== POPUP XÁC NHẬN HỦY SÂN chờ duyệt ===== -->
    <StackPane fx:id="popupHuy" managed="false" prefHeight="800" prefWidth="1200" style="-fx-background-color: rgba(0, 0, 0, 0.6);" visible="false">
        <VBox alignment="CENTER" maxWidth="420" spacing="18" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 32; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 30, 0, 0, 10);">
            
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #dc2626;" text="🗑  Xác nhận hủy đặt sân" />
            
            <VBox alignment="CENTER" spacing="6">
                <Label fx:id="lblHuyTenSan" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Tên sân ở đây" wrapText="true" />
                <Label maxWidth="360" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8; -fx-text-alignment: center;" text="Lưu ý: Hành động này không thể hoàn tác sau khi đã xác nhận hủy." wrapText="true" />
            </VBox>

            <Separator style="-fx-padding: 4 0 4 0;" />

            <!-- Nút điều hướng -->
            <HBox spacing="12">
                <Button maxWidth="Infinity" onAction="#handleDongHuy" style="-fx-background-color: white; -fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 0 12 0; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-border-width: 1; -fx-cursor: hand;" text="Quay lại" HBox.hgrow="ALWAYS" />
                <Button maxWidth="Infinity" onAction="#handleXacNhanHuy" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 12 0 12 0; -fx-cursor: hand;" text="Xác nhận hủy" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </StackPane>
    
</StackPane>
