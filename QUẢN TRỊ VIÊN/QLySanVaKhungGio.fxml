<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="1030.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.guidemo.SanVaKhungGioController">
    <children>
        <VBox alignment="CENTER" spacing="50.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label text="HỆ THỐNG QUẢN LÝ SÂN  &amp; KHUNG GIỜ">
                            <font>
                                <Font name="System Bold" size="30.0" />
                            </font>
                        </Label>
                        <Label text="Vui lòng lựa chọn phân hệ bạn muốn thao tác tiếp theo" textFill="#666666">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <GridPane hgap="40.0" maxWidth="750.0" prefHeight="250.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>

                        <Button fx:id="btnQuanLySan" contentDisplay="TOP" maxHeight="165.0" maxWidth="364.0" mnemonicParsing="false" onAction="#handleMoQuanLySan" prefHeight="165.0" prefWidth="364.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 15; -fx-border-width: 1.5; -fx-cursor: hand;" text="QUẢN LÝ SÂN" textAlignment="CENTER">
                            <graphic>
                                <ImageView fitHeight="90.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../image/icons8-stadium-100.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                            <padding>
                                <Insets bottom="20.0" top="20.0" />
                            </padding>
                        </Button>

                        <Button fx:id="btnQuanLyKG" contentDisplay="TOP" maxHeight="166.0" maxWidth="371.0" mnemonicParsing="false" onAction="#handleMoQuanLyKhungGio" prefHeight="166.0" prefWidth="371.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 15; -fx-border-width: 1.5; -fx-cursor: hand;" text="QUẢN LÝ KHUNG GIỜ" textAlignment="CENTER" GridPane.columnIndex="1">
                            <graphic>
                                <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../image/icons8-clock-100.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                            <padding>
                                <Insets bottom="20.0" top="20.0" />
                            </padding>
                        </Button>

                    </children>
                </GridPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
