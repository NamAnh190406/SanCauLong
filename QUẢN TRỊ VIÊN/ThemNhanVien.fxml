<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1030.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.guidemo.ThemNhanVienController">
   <children>
      <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <left>
            <Pane prefWidth="150.0" BorderPane.alignment="CENTER" />
         </left>
         <right>
            <Pane prefWidth="150.0" BorderPane.alignment="CENTER" />
         </right>
         <center>
            <BorderPane style="-fx-border-color: #336633; -fx-border-radius: 10; -fx-background-color: #FFFFFF;" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="30.0" top="30.0" />
               </BorderPane.margin>
               <top>
                  <HBox alignment="CENTER_LEFT" prefHeight="80.0" BorderPane.alignment="CENTER">
                     <children>
                        <Label text="THÊM NHÂN VIÊN MỚI">
                           <font>
                              <Font name="System Bold" size="24.0" />
                           </font>
                        </Label>
                     </children>
                     <BorderPane.margin>
                        <Insets left="20.0" />
                     </BorderPane.margin>
                  </HBox>
               </top>
               <center>
                  <VBox spacing="10.0" stylesheets="@../../../style.css" BorderPane.alignment="CENTER">
                     <children>
                        <Label text="Mã nhân viên (*)" />
                        <TextField fx:id="txtMaNV" promptText="Ví dụ: NV001" styleClass="text-field-pill" />

                        <Label text="Họ và tên (*)" />
                        <TextField fx:id="txtHoTen" promptText="Nhập đầy đủ họ và tên" styleClass="text-field-pill" />

                        <Label text="Số điện thoại (*)" />
                        <TextField fx:id="txtSDT" promptText="Ví dụ: 0912345678" styleClass="text-field-pill" />

                        <Label text="Chức vụ (*)" />
                        <ComboBox fx:id="cbChucVu" prefHeight="35.0" prefWidth="1000.0" promptText="-- Chọn chức vụ --" />
                     </children>
                     <BorderPane.margin>
                        <Insets left="20.0" right="20.0" />
                     </BorderPane.margin>
                  </VBox>
               </center>
               <bottom>
                  <VBox prefHeight="160.0" BorderPane.alignment="CENTER">
                     <children>
                        <GridPane prefHeight="80.0" vgap="5.0">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>
                           <children>
                              <Label text="Ca làm việc (*)">
                                 <font>
                                    <Font name="System Bold" size="12.0" />
                                 </font></Label>
                              <RadioButton fx:id="rdCa1" mnemonicParsing="false" text="Ca 1 (Sáng)" GridPane.rowIndex="1">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="groupCaLamViec" />
                                 </toggleGroup>
                              </RadioButton>
                              <RadioButton fx:id="rdCa2" mnemonicParsing="false" text="Ca 2 (Chiều)" toggleGroup="$groupCaLamViec" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                              <RadioButton fx:id="rdCa3" mnemonicParsing="false" text="Ca 3 (Đêm)" toggleGroup="$groupCaLamViec" GridPane.rowIndex="2" />
                           </children>
                           <VBox.margin>
                              <Insets left="20.0" />
                           </VBox.margin>
                        </GridPane>
                        <FlowPane alignment="BOTTOM_RIGHT" hgap="20.0" prefHeight="60.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleThoat" prefHeight="38.0" prefWidth="80.0" style="-fx-background-color: #FF0000;" styleClass="btn-round" text="Thoát" textFill="WHITE" />
                              <Button mnemonicParsing="false" onAction="#handleLuuNhanVien" prefHeight="38.0" prefWidth="80.0" style="-fx-background-color: #009933;" styleClass="btn-round" text="Thêm" textFill="WHITE" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="20.0" right="20.0" />
                           </VBox.margin>
                        </FlowPane>
                     </children>
                  </VBox>
               </bottom>
            </BorderPane>
         </center>
      </BorderPane>
   </children>
</AnchorPane>