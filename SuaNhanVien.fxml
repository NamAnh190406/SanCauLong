<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1030.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.mavenproject1.SuaNhanVienController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="CẬP NHẬT THÔNG TIN NHÂN VIÊN" textFill="#FFA500">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="40.0" />
                    </VBox.margin>
                </Label>

                <GridPane hgap="20.0" maxWidth="600.0" vgap="25.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="180.0" minWidth="10.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="450.0" minWidth="10.0" prefWidth="410.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Mã nhân viên:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtMaNV" editable="false" prefHeight="35.0" style="-fx-background-color: #E0E0E0;" styleClass="text-field-pill" GridPane.columnIndex="1" />

                        <Label text="Họ và tên (*):" GridPane.rowIndex="1">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtHoTen" prefHeight="35.0" styleClass="text-field-pill" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Số điện thoại (*):" GridPane.rowIndex="2">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="txtSDT" prefHeight="35.0" styleClass="text-field-pill" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Chức vụ (*):" GridPane.rowIndex="3">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="cbChucVu" prefHeight="35.0" prefWidth="430.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Ca làm việc (*):" GridPane.rowIndex="4">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" spacing="30.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <children>
                                <RadioButton fx:id="rdCa1" mnemonicParsing="false" text="Ca 1 (Sáng)">
                                    <toggleGroup>
                                        <ToggleGroup fx:id="groupCaLamViec" />
                                    </toggleGroup>
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </RadioButton>
                                <RadioButton fx:id="rdCa2" mnemonicParsing="false" text="Ca 2 (Chiều)" toggleGroup="$groupCaLamViec">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </RadioButton>
                                <RadioButton fx:id="rdCa3" mnemonicParsing="false" text="Ca 3 (Tối)" toggleGroup="$groupCaLamViec">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </RadioButton>
                            </children>
                        </HBox>
                    </children>
                </GridPane>

                <HBox alignment="CENTER" prefHeight="80.0" spacing="40.0">
                    <children>
                        <Button mnemonicParsing="false" onMouseClicked="#handleThoat" prefHeight="40.0" prefWidth="100.0" text="Hủy bỏ">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
                        <Button mnemonicParsing="false" onMouseClicked="#handleLuuCapNhat" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #FFA500;" text="Lưu thay đổi" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
