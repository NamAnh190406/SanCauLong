<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="568.0" prefWidth="433.0" spacing="16" style="-fx-background-color: white; -fx-background-radius: 8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ThemDatSanController">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24" />
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Thêm Đặt Sân Mới" />

    <VBox spacing="8">
        <Label text="Tên khách hàng *" textFill="#6b7280" />
        <TextField fx:id="txtTenKhachHang" promptText="Nhập tên khách hàng" style="-fx-padding: 8 12; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;" />
    </VBox>

    <VBox spacing="8">
        <Label text="Số điện thoại *" textFill="#6b7280" />
        <TextField fx:id="txtSoDienThoai" promptText="Nhập số điện thoại" style="-fx-padding: 8 12; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-background-radius: 6;" />
    </VBox>

    <VBox spacing="8">
        <Label text="Chọn sân *" textFill="#6b7280" />
        <ComboBox fx:id="cbxChonSan" maxWidth="Infinity" promptText="Chọn sân..." style="-fx-background-color: #f0fdf4; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-padding: 4 8;" />
    </VBox>

    <HBox spacing="16">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Giờ bắt đầu *" textFill="#6b7280" />
            <ComboBox fx:id="cbxGioBatDau" maxWidth="Infinity" promptText="Chọn giờ..." style="-fx-background-color: #f0fdf4; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-padding: 4 8;" />
        </VBox>
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Thời lượng *" textFill="#6b7280" />
            <ComboBox fx:id="cbxThoiLuong" maxWidth="Infinity" promptText="1 giờ" style="-fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-padding: 4 8;" />
        </VBox>
    </HBox>

    <VBox spacing="8" style="-fx-background-color: #f0fdf4; -fx-border-color: #bbf7d0; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Thông tin đặt sân:" />
        <Label fx:id="lblPreviewSan" text="Sân: (Chưa chọn)" textFill="#4b5563" />
        <Label fx:id="lblPreviewGio" text="Giờ: (Chưa chọn)" textFill="#4b5563" />
        <Label fx:id="lblPreviewGia" style="-fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Giá: 0đ" />
    </VBox>

    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="btnHuy" maxWidth="Infinity" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-cursor: hand;" text="Hủy" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnXacNhan" maxWidth="Infinity" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-cursor: hand;" text="Xác nhận" HBox.hgrow="ALWAYS" />
    </HBox>

</VBox>
