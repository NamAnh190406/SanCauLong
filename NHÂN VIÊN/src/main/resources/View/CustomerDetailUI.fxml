                              <Button fx:id="btnEdit" maxWidth="Infinity" style="-fx-background-color: #eab308; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;" text="Chưa thanh toán" />
