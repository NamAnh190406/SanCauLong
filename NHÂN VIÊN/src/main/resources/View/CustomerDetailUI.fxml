                        </VBox>
                        
                        <VBox>
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Số điện thoại" />
                              <Label fx:id="lblPhoneNumber" style="-fx-font-size: 13px; -fx-text-fill: #111827;" text="0901234567" />
                           </children>
                        </VBox>
                        
                        <VBox>
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" text="Sân" />
