                              <Button fx:id="btnClose" maxWidth="Infinity" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;" text="Đóng" />
