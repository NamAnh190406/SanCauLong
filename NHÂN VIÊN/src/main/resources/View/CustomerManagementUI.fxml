<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CustomerManagementController">
    <children>
        <VBox style="-fx-background-color: white;">
            <VBox spacing="16.0" style="-fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0; -fx-padding: 16;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Danh Sách Khách Hàng" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox fx:id="actionButtonsBox" spacing="8.0" alignment="CENTER_RIGHT">
                        <Button fx:id="btnAddCustomer" text="+ Thêm khách hàng" style="-fx-background-color: #eab308; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" />
                        <Button fx:id="btnDeleteSelected" text="Xóa" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" visible="false" managed="false">
                            <graphic>
                                <SVGPath content="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6" fill="transparent" scaleX="0.6" scaleY="0.6" stroke="#ffffff" strokeLineCap="ROUND" strokeLineJoin="ROUND" strokeWidth="2.0" />
                            </graphic>
                        </Button>
                        <Button fx:id="btnCancelSelection" text="Hủy" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" visible="false" managed="false"/>
                    </HBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 4 12;" spacing="8.0">
                    <SVGPath content="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" fill="transparent" stroke="#9ca3af" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND"/>
                    <TextField fx:id="txtSearch" promptText="Tìm kiếm khách hàng..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 8 0;" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <TableView fx:id="tableCustomers" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-width: 0;">
                <columns>
                    <TableColumn fx:id="colCheckbox" prefWidth="50" sortable="false" />
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colName" text="Tên khách hàng" prefWidth="150" />
                    <TableColumn fx:id="colPhone" text="Số điện thoại" prefWidth="120" />
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="180" />
                    <TableColumn fx:id="colAddress" text="Địa chỉ" prefWidth="150" />
                    <TableColumn fx:id="colTotalBookings" text="Số lần đặt" prefWidth="80" />
                    <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" />
                    <TableColumn fx:id="colActions" text="Thao tác" prefWidth="100" sortable="false"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" style="-fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0; -fx-padding: 16;" spacing="16.0">
                <Label text="Tổng số:" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
                <Label fx:id="lblTotalCount" text="0" style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label text="khách hàng" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
                
                <HBox fx:id="selectedCountBox" alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false">
                    <Label text="Đã chọn:" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
                    <Label fx:id="lblSelectedCount" text="0" style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </HBox>
            </HBox>
        </VBox>

        <VBox fx:id="addCustomerModal" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.5);" visible="false">
            <VBox maxWidth="450" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 24;" spacing="16.0">
                <Label text="Thêm Khách Hàng Mới" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                
                <VBox spacing="8.0">
                    <Label text="Tên khách hàng *" style="-fx-text-fill: #6b7280;"/>
                    <TextField fx:id="txtAddName" promptText="Nhập tên khách hàng" style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-background-color: white;"/>
                </VBox>
                
                <VBox spacing="8.0">
                    <Label text="Số điện thoại *" style="-fx-text-fill: #6b7280;"/>
                    <TextField fx:id="txtAddPhone" promptText="Nhập số điện thoại" style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-background-color: white;"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label text="Email" style="-fx-text-fill: #6b7280;"/>
                    <TextField fx:id="txtAddEmail" promptText="Nhập email" style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-background-color: white;"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label text="Địa chỉ" style="-fx-text-fill: #6b7280;"/>
                    <TextField fx:id="txtAddAddress" promptText="Nhập địa chỉ" style="-fx-padding: 8; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #e5e7eb; -fx-background-color: white;"/>
                </VBox>

                <HBox spacing="12.0" style="-fx-padding: 16 0 0 0;">
                    <Button fx:id="btnCancelAdd" text="Hủy" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8; -fx-cursor: hand;"/>
                    <Button fx:id="btnConfirmAdd" text="Xác nhận" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </children>
</StackPane>