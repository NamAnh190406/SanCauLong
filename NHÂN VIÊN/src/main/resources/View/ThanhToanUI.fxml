<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controller.ThanhToanController"
      style="-fx-background-color: #f3f4f6;">

    <VBox spacing="20.0" style="-fx-padding: 24;" VBox.vgrow="ALWAYS">

        <!-- TIÊU ĐỀ + NÚT -->
        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Thanh Toán"/>
                <Label style="-fx-text-fill: #6b7280;" text="Quản lý giao dịch thanh toán"/>
            </VBox>
            <Button onAction="#onTaoThanhToan"
                style="-fx-background-color: #00C853; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;"
                text="+ Tạo thanh toán"/>
        </HBox>

        <!-- STAT CARDS -->
        <HBox spacing="16.0">
            <HBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" text="Tổng giao dịch"/>
                    <Label fx:id="lblTongGD" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="0"/>
                </VBox>
                <Label style="-fx-font-size: 28px;" text="🧾"/>
            </HBox>
            <HBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" text="Đã thanh toán"/>
                    <Label fx:id="lblDaThanhToan" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="0"/>
                </VBox>
                <Label style="-fx-font-size: 28px;" text="✅"/>
            </HBox>
            <HBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" text="Chờ thanh toán"/>
                    <Label fx:id="lblChoThanhToan" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #d97706;" text="0"/>
                </VBox>
                <Label style="-fx-font-size: 28px;" text="⏳"/>
            </HBox>
            <HBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" text="Tổng thu"/>
                    <Label fx:id="lblTongThu" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="0 ₫"/>
                </VBox>
                <Label style="-fx-font-size: 28px;" text="💰"/>
            </HBox>
        </HBox>

        <!-- BỘ LỌC -->
        <HBox alignment="CENTER_LEFT" spacing="12.0"
            style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Lọc:"/>
            <ComboBox fx:id="cbTrangThai" promptText="Tất cả trạng thái" prefWidth="180"/>
            <TextField fx:id="tfSearch" promptText="Tìm mã GD, mã hóa đơn..." prefWidth="250"
                onKeyReleased="#onSearch"
                style="-fx-background-radius: 6; -fx-border-color: #e5e7eb; -fx-border-radius: 6; -fx-padding: 6 10;"/>
            <Button onAction="#onLoc"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand;"
                text="Lọc"/>
            <Button onAction="#onXemTat"
                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-padding: 6 14; -fx-background-radius: 6; -fx-cursor: hand;"
                text="Xem tất cả"/>
        </HBox>

        <!-- BẢNG -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);" VBox.vgrow="ALWAYS">
            <TableView fx:id="tableThanhToan" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <columns>
                    <TableColumn fx:id="colMaTT" text="Mã GD" prefWidth="110"/>
                    <TableColumn fx:id="colMaHD" text="Mã Hóa Đơn" prefWidth="130"/>
                    <TableColumn fx:id="colPTTT" text="Phương thức" prefWidth="130"/>
                    <TableColumn fx:id="colSoTien" text="Số Tiền" prefWidth="130"/>
                    <TableColumn fx:id="colThoiGian" text="Thời Gian" prefWidth="160"/>
                    <TableColumn fx:id="colTrangThai" text="Trạng Thái" prefWidth="130"/>
                    <TableColumn fx:id="colThaoTac" text="Thao Tác" prefWidth="120"/>
                </columns>
                <placeholder>
                    <Label text="Không có dữ liệu thanh toán" style="-fx-text-fill: #9ca3af;"/>
                </placeholder>
            </TableView>
        </VBox>
    </VBox>
</VBox>