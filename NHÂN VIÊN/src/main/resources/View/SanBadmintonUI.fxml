<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>

<AnchorPane xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.SanBadmintonController">
   <stylesheets>
      <URL value="@style.css" />
   </stylesheets>
   <children>
      <!-- ===== ROOT: Schedule (left) + Detail panel (right) ===== -->
      <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

         <!-- ===== LEFT: full schedule area ===== -->
         <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: white;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color: white; -fx-padding: 12 20;
                         -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">

               <Button fx:id="btnPrevDay" mnemonicParsing="false" text="&#x276E;"
                       onAction="#onPrevDay"
                       style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151;
                              -fx-font-size: 14; -fx-cursor: hand;
                              -fx-background-radius: 6; -fx-min-width: 34; -fx-min-height: 34;" />

               <HBox alignment="CENTER" spacing="8"
                     style="-fx-background-color: #f9fafb; -fx-background-radius: 8;
                            -fx-padding: 6 16; -fx-border-color: #e5e7eb; -fx-border-radius: 8;">
                  <Label text="&#x1F4C5;" style="-fx-font-size: 14; -fx-text-fill: #6b7280;" />
                  <Label fx:id="lblDate"
                         style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #111827;"
                         text="01/05/2026" />
               </HBox>

               <Button fx:id="btnNextDay" mnemonicParsing="false" text="&#x276F;"
                       onAction="#onNextDay"
                       style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151;
                              -fx-font-size: 14; -fx-cursor: hand;
                              -fx-background-radius: 6; -fx-min-width: 34; -fx-min-height: 34;" />

               <Region HBox.hgrow="ALWAYS" />

               <Button fx:id="btnAddBooking" mnemonicParsing="false"
                       text="+ Th&#xEA;m &#x111;&#x1EB7;t s&#xE2;n"
                       onAction="#onAddBooking"
                       style="-fx-background-color: #f59e0b; -fx-text-fill: white;
                              -fx-font-weight: bold; -fx-font-size: 13;
                              -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8 18;" />
            </HBox>

            <!-- SCHEDULE GRID -->
            <ScrollPane fx:id="scheduleScroll" fitToWidth="true"
                        VBox.vgrow="ALWAYS" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color: white; -fx-background: white;
                               -fx-border-color: transparent;">
               <content>
                  <GridPane fx:id="scheduleGrid"
                            style="-fx-background-color: white;"
                            gridLinesVisible="true" />
               </content>
            </ScrollPane>

            <!-- LEGEND -->
            <HBox alignment="CENTER_LEFT" spacing="24"
                  style="-fx-background-color: white; -fx-padding: 10 20;
                         -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">
               <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label style="-fx-background-color: white; -fx-border-color: #d1d5db;
                                -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;
                                -fx-min-width: 18; -fx-min-height: 18;
                                -fx-max-width: 18; -fx-max-height: 18;" text="" />
                  <Label text="Tr&#x1ED1;ng" style="-fx-font-size: 12; -fx-text-fill: #374151;" />
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label style="-fx-background-color: #fef9c3; -fx-border-color: #fcd34d;
                                -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;
                                -fx-min-width: 18; -fx-min-height: 18;
                                -fx-max-width: 18; -fx-max-height: 18;" text="" />
                  <Label text="&#x110;&#xE3; &#x111;&#x1EB7;t" style="-fx-font-size: 12; -fx-text-fill: #374151;" />
               </HBox>
               <HBox alignment="CENTER_LEFT" spacing="8">
                  <Label style="-fx-background-color: #dcfce7; -fx-border-color: #86efac;
                                -fx-border-width: 2; -fx-border-radius: 4; -fx-background-radius: 4;
                                -fx-min-width: 18; -fx-min-height: 18;
                                -fx-max-width: 18; -fx-max-height: 18;" text="" />
                  <Label text="&#x110;ang ch&#x1A1;i" style="-fx-font-size: 12; -fx-text-fill: #374151;" />
               </HBox>
            </HBox>

         </VBox>

         <!-- ===== RIGHT: Detail panel (hidden by default) ===== -->
         <VBox fx:id="detailPanel"
               prefWidth="300" minWidth="300" maxWidth="300"
               managed="false" visible="false"
               style="-fx-background-color: white;
                      -fx-border-color: #e5e7eb; -fx-border-width: 0 0 0 1;">

            <!-- Panel header -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-padding: 14 16; -fx-border-color: #e5e7eb; -fx-border-width: 0 0 1 0;">
               <Label text="&#x1F4CB;" style="-fx-font-size: 15;" />
               <Label text="Th&#xF4;ng tin &#x111;&#x1EB7;t s&#xE2;n"
                      style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #111827;" />
               <Region HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" text="&#x2715;"
                       onAction="#onCloseDetail"
                       style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                              -fx-font-size: 14; -fx-cursor: hand; -fx-padding: 2 6;" />
            </HBox>

            <!-- Scrollable content -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER"
                        style="-fx-background-color: #f9fafb; -fx-background: #f9fafb;
                               -fx-border-color: transparent;">
               <content>
                  <VBox spacing="12" style="-fx-padding: 14;">

                     <!-- Booking info card -->
                     <VBox fx:id="infoCard" spacing="10"
                           style="-fx-background-color: white; -fx-background-radius: 10;
                                  -fx-padding: 14; -fx-border-color: #f3f4f6;
                                  -fx-border-width: 1; -fx-border-radius: 10;">

                        <!-- Dynamic rows injected by controller -->
                        <VBox spacing="2">
                           <Label text="Kh&#xE1;ch h&#xE0;ng"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblCustomer"
                                  style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;"
                                  text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label text="S&#x1ED1; &#x111;i&#x1EC7;n tho&#x1EA1;i"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblPhone"
                                  style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label text="S&#xE2;n"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblCourt"
                                  style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label text="Th&#x1EDD;i gian"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblTime"
                                  style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label text="Ng&#xE0;y"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblBookingDate"
                                  style="-fx-font-size: 13; -fx-text-fill: #111827;" text="-" />
                        </VBox>
                        <VBox spacing="2">
                           <Label text="Tr&#x1EA1;ng th&#xE1;i"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblStatus"
                                  style="-fx-font-size: 11; -fx-font-weight: bold;
                                         -fx-background-radius: 5; -fx-padding: 3 10;"
                                  text="&#x110;&#xE3; &#x111;&#x1EB7;t" />
                        </VBox>
                        <VBox spacing="2">
                           <Label text="T&#x1ED5;ng ti&#x1EC1;n"
                                  style="-fx-font-size: 11; -fx-text-fill: #6b7280;" />
                           <Label fx:id="lblTotal"
                                  style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #16a34a;"
                                  text="-" />
                        </VBox>

                        <Separator />

                        <!-- Action buttons -->
                        <Button fx:id="btnConfirm" maxWidth="Infinity"
                                mnemonicParsing="false" text="&#x2714; X&#xE1;c nh&#x1EAD;n"
                                onAction="#onConfirmBooking"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" />
                        <Button fx:id="btnEdit" maxWidth="Infinity"
                                mnemonicParsing="false" text="&#x270F; Ch&#x1EC9;nh s&#x1EED;a"
                                onAction="#onEditBooking"
                                style="-fx-background-color: #f59e0b; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" />
                        <Button fx:id="btnCancelBooking" maxWidth="Infinity"
                                mnemonicParsing="false" text="&#x1F5D1; H&#x1EE7;y &#x111;&#x1EB7;t s&#xE2;n"
                                onAction="#onCancelBooking"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" />
                        <Button maxWidth="Infinity"
                                mnemonicParsing="false" text="&#x2716; &#x110;&#xF3;ng"
                                onAction="#onCloseDetail"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 8;
                                       -fx-padding: 9 0; -fx-cursor: hand; -fx-font-size: 13;" />
                     </VBox>

                     <!-- Waiting list -->
                     <VBox fx:id="waitingListBox" spacing="8"
                           style="-fx-background-color: white; -fx-background-radius: 10;
                                  -fx-padding: 14; -fx-border-color: #f3f4f6;
                                  -fx-border-width: 1; -fx-border-radius: 10;">
                        <Label text="&#x23F3; Danh s&#xE1;ch &#x111;&#x1EE3;i"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #111827;" />
                        <!-- Items injected by controller -->
                     </VBox>

                  </VBox>
               </content>
            </ScrollPane>
         </VBox>

      </HBox>
   </children>
</AnchorPane>
