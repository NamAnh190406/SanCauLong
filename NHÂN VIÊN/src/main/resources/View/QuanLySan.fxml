<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="511.0" prefWidth="441.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.QuanLySanController">
   <children>
      <VBox layoutX="10.0" layoutY="10.0" prefHeight="511.0" prefWidth="441.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <!-- Tiêu đề trang -->
            <Label text="Danh sách sân cầu lông" textFill="#333333">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            
            <!-- Thanh công cụ (Tìm kiếm & Nút thêm) -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <TextField fx:id="txtTimKiem" prefHeight="35.0" prefWidth="250.0" promptText="🔍 Tìm kiếm tên sân..." style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-color: #E0E0E0; -fx-border-radius: 5;" />
                  <Button mnemonicParsing="false" prefHeight="35.0" style="-fx-background-color: #00A651; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="+ Thêm sân mới" fx:id="btnThemSan" onAction="#handleAddSan"/>
               </children>
            </HBox>
            
            <!-- Bảng hiển thị dữ liệu -->
            <TableView fx:id="tableSan" prefHeight="380.0" prefWidth="401.0" style="-fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colMaSan" prefWidth="70.0" text="Mã Sân" />
                <TableColumn fx:id="colTenSan" prefWidth="120.0" text="Tên Sân" />
                  <TableColumn fx:id="colLoaiSan" prefWidth="90.0" text="Loại Sân" />
                  <TableColumn fx:id="colGiaThue" prefWidth="100.0" text="Giá/Giờ" />
                  <TableColumn fx:id="colTrangThai" prefWidth="100.0" text="Trạng Thái" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
